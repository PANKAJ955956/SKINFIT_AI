# ==============================================================================
# SkinFit AI - Environment Configuration Example
# ==============================================================================

# Database Configuration
# Docker compose default:
DATABASE_URL=postgresql+psycopg://skinfit:skinfit_dev@db:5432/skinfit
# Local standalone development default fallback (if running without Docker):
# DATABASE_URL=sqlite+aiosqlite:///./skinfit.db

# Authentication Security
JWT_SECRET_KEY=replace_with_a_secure_random_secret_at_least_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI & LLM Provider Configuration
# Options for LLM_PROVIDER: "local", "gemini", "openai"
LLM_PROVIDER=local
# Options for EMBEDDING_PROVIDER: "local", "gemini", "openai", "sentence_transformers"
EMBEDDING_PROVIDER=local
OPENAI_API_KEY=
GEMINI_API_KEY=

# Vector Database Configuration
# Options: "chroma", "faiss", "memory"
VECTOR_STORE=chroma
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_PERSIST_DIRECTORY=./chroma_data

# Redis Cache (Optional)
REDIS_URL=redis://redis:6379/0

# Storage Paths
IMAGE_STORAGE_PATH=/app/storage
MAX_UPLOAD_SIZE_MB=15

# Public API URL for Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
